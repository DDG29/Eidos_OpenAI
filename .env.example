# Claude API key (server only). Without it, EIDOS runs fully in Demo Mode.
ANTHROPIC_API_KEY=

# 32 random bytes, base64, used to encrypt session tokens (AES-256-GCM).
# In development a value is generated and written to .env.local automatically if missing.
SESSION_SECRET=

# Allow visitors to bring their own key (sent per request in a header, never stored).
ALLOW_BYOK=false

# Maximum estimated spend per day (USD) for this deployment. BYOK requests do not count.
DAILY_BUDGET_USD=25

# PDF limits.
MAX_PDF_MB=32
MAX_PDF_PAGES=100

# Optional per-agent model overrides. Example: EIDOS_MODEL_DIRECTOR=claude-opus-5-5
EIDOS_MODEL_READER=
EIDOS_MODEL_CARTOGRAPHER=
EIDOS_MODEL_DIRECTOR=
EIDOS_MODEL_SKEPTIC=
EIDOS_MODEL_TUTOR=
EIDOS_MODEL_EVALUATOR=
EIDOS_MODEL_GARDENER=
EIDOS_MODEL_BRANCHER=
EIDOS_MODEL_LENS=

# Server web tool versions (see DECISIONS.md #4).
EIDOS_WEB_SEARCH_VERSION=web_search_20260209
EIDOS_WEB_FETCH_VERSION=web_fetch_20260209

# Set to 1 to disable server-side refusal fallbacks on Opus 5.5 / Sonnet 5.5 (DECISIONS.md #7).
EIDOS_DISABLE_FALLBACKS=0

# Per-IP limits per hour.
LIMIT_FORGE_PER_HOUR=6
LIMIT_ASK_PER_HOUR=60
LIMIT_GRADE_PER_HOUR=120
LIMIT_GROW_PER_HOUR=20

# Optional: short share links and distributed limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Debug: dumps SSE events to ./.debug and records replays (development only).
EIDOS_DEBUG=0

NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_SITE_URL=http://localhost:3000
