 "facts": [
  {
   "id": "F01",
   "text": "In PISA 2025, 41.8% of 15-year-old students in Mexico were below the baseline level in mathematics, reading and science at the same time; the OECD average was 19.7%.",
   "conceptId": "C01",
   "origin": "web",
   "citations": [
    {
     "kind": "web",
     "citedText": "41.8 por ciento quedó por debajo del nivel básico en matemáticas, lectura y ciencias al mismo tiempo; promedio de la OCDE, que fue de 19.7 por ciento",
     "documentIndex": -1,
     "documentTitle": "Por Esto (8 sep 2026)",
     "url": "https://www.poresto.com/mexico/2026/9/8/mexico-retrocede-en-pisa-2025-baja-en-matematicas-y-418-de-estudiantes-queda-debajo-del-nivel-basico.html",
     "title": "México retrocede en PISA 2025"
    }
   ]
  },
  {
   "id": "F02",
   "text": "Mexico scored 388 in mathematics (OECD: 463), 408 in reading (OECD: 461) and 414 in science (OECD: 482).",
   "conceptId": "C01",
   "origin": "web",
   "citations": [
    {
     "kind": "web",
     "citedText": "México alcanzó 388 puntos … 75 por debajo del promedio de la OCDE, que fue de 463 puntos; 408 puntos, frente a los 461; 414 puntos, mientras que la media de la OCDE fue de 482",
     "documentIndex": -1,
     "documentTitle": "Por Esto (8 sep 2026)",
     "url": "https://www.poresto.com/mexico/2026/9/8/mexico-retrocede-en-pisa-2025-baja-en-matematicas-y-418-de-estudiantes-queda-debajo-del-nivel-basico.html",
     "title": "México retrocede en PISA 2025"
    }
   ]
  },
  {
   "id": "F03",
   "text": "Eight in ten Mexican students said they feel curious about different topics, compared with 73% on the international average.",
   "conceptId": "C02",
   "origin": "web",
   "citations": [
    {
     "kind": "web",
     "citedText": "Ocho de cada 10 dijeron sentir curiosidad por distintos temas, frente a 73 por ciento del promedio internacional",
     "documentIndex": -1,
     "documentTitle": "La Razón (9 sep 2026)",
     "url": "https://www.razon.com.mx/mexico/2026/09/09/revela-pisa-deuda-en-aprendizaje-y-que-aun-impacta-brecha-economica/",
     "title": "Revela PISA deuda en aprendizaje"
    }
   ]
  }
